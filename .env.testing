# Loaded INSTEAD of .env when APP_ENV=testing (set in phpunit.xml), so tests
# never see production credentials. Safe to commit: nothing here is secret.
# phpunit.xml forces the database and driver settings on top of this file.

APP_NAME=Hardcity
APP_ENV=testing
APP_KEY=base64:LJikEpvLIRNAzhmaTKCn+Vy2e+VkHUd84FQbW9fQxq0=
APP_DEBUG=true
APP_URL=http://localhost

# Business constants the code reads with env()
IMG_URL=http://localhost/uploads/
GST_PER=9
FUEL_SUBCHARGE=20
HANDLING_PER=2

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hwc_backend_testing
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array
MAIL_USERNAME=noreply@example.test
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="${APP_NAME}"

INTEGRATION_API_KEY=test-integration-key
PAYMENT_VERIFICATION_MODE=enforce
